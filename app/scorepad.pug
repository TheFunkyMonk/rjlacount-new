extends layouts/default

block content

	- var secondaryHeadline = 'my-4 font-bold text-3xl sm:text-4xl md:text-5xl leading-tight text-purple-600 dark:text-white';
	- var link = "font-bold text-gray-800 underline hover:text-purple-600 dark:text-white transition-colors duration-150";

	section(class='mt-8 md:mt-16 lg:mt-24 mb-16 md:mb-24 relative z-10')
		div(class='container mx-auto')
			div(class='flex flex-wrap h-full pt-8 md:py-8 xl:py-16')
				div(class='w-full px-4')
					h1(class=secondaryHeadline) ScorePad Privacy Policy
					p(class='my-4 text-xl md:text-2xl leading-relaxed text-gray-800') ScorePad does not collect, store, or transmit any personal data. All information entered in the app (player names, scores) exists only on your device and is never shared with anyone.
					p(class='my-4 text-xl md:text-2xl leading-relaxed text-gray-800') ScorePad does not use analytics, advertising, or any third-party SDKs.
					p(class='my-4 text-xl md:text-2xl leading-relaxed text-gray-800') If you have questions, contact #[a(href='mailto:rjlacount@gmail.com' class=link) rjlacount@gmail.com].
					p(class='my-4 text-xl md:text-2xl leading-relaxed text-gray-800') Last updated: July 2026