---
import Layout from '../../layouts/Layout.astro';
import PlainTextPage from '../../components/PlainTextPage.astro';

const link = 'font-bold text-gray-800 underline hover:text-purple-600 dark:text-white transition-colors duration-150';
---

<Layout title="Astronomy Buddy Privacy Policy - R.J. LaCount" description="Privacy policy for the Astronomy Buddy app." noindex>
	<PlainTextPage title="Astronomy Buddy Privacy Policy">
		<p class="my-4 text-xl md:text-2xl leading-relaxed text-gray-800">
			Astronomy Buddy sends your location to its API to calculate sky visibility and conditions for that location. No other personal data is collected, stored, or shared.
		</p>
		<p class="my-4 text-xl md:text-2xl leading-relaxed text-gray-800">
			Astronomy Buddy does not use analytics, advertising, or any third-party SDKs.
		</p>
		<p class="my-4 text-xl md:text-2xl leading-relaxed text-gray-800">
			If you have questions, contact <a href="mailto:rjlacount@gmail.com" class={link}>rjlacount@gmail.com</a>.
		</p>
		<p class="my-4 text-xl md:text-2xl leading-relaxed text-gray-800">Last updated: July 2026</p>
	</PlainTextPage>
</Layout>
