---
import Layout from '../../layouts/Layout.astro';
import PlainTextPage from '../../components/PlainTextPage.astro';

const link = 'font-bold text-gray-800 underline hover:text-purple-600 dark:text-white transition-colors duration-150';
---

<Layout title="ScorePad Privacy Policy - R.J. LaCount" description="Privacy policy for the ScorePad app." noindex>
	<PlainTextPage title="ScorePad Privacy Policy">
		<p class="my-4 text-xl md:text-2xl leading-relaxed text-gray-800">
			ScorePad does not collect, store, or transmit any personal data. All information entered in the app (player names, scores) exists only on your device and is never shared with anyone.
		</p>
		<p class="my-4 text-xl md:text-2xl leading-relaxed text-gray-800">
			ScorePad does not use analytics, advertising, or any third-party SDKs.
		</p>
		<p class="my-4 text-xl md:text-2xl leading-relaxed text-gray-800">
			If you have questions, contact <a href="mailto:rjlacount@gmail.com" class={link}>rjlacount@gmail.com</a>.
		</p>
		<p class="my-4 text-xl md:text-2xl leading-relaxed text-gray-800">Last updated: July 2026</p>
	</PlainTextPage>
</Layout>
