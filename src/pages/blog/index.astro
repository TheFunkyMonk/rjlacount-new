---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const secondaryHeadline = 'my-4 font-bold text-3xl sm:text-4xl md:text-5xl leading-tight text-purple-600 dark:text-white';
const link = 'font-bold text-gray-800 underline hover:text-purple-600 dark:text-white transition-colors duration-150';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog - R.J. LaCount" description="Posts from R.J. LaCount." noindex>
	<section class="mt-8 md:mt-16 lg:mt-24 mb-16 md:mb-24 relative z-10">
		<div class="container mx-auto">
			<div class="flex flex-wrap h-full pt-8 md:py-8 xl:py-16">
				<div class="w-full px-4">
					<h1 class={secondaryHeadline}>Blog</h1>

					{
						posts.length === 0 ? (
							<p class="my-4 text-xl md:text-2xl leading-relaxed text-gray-800">Nothing here yet — check back soon.</p>
						) : (
							<ul class="my-4">
								{posts.map((post) => (
									<li class="my-8">
										<a href={`/blog/${post.id}`} class={`${link} text-2xl md:text-3xl no-underline`}>
											{post.data.title}
										</a>
										<p class="my-2 text-lg text-gray-800">{post.data.description}</p>
									</li>
								))}
							</ul>
						)
					}
				</div>
			</div>
		</div>
	</section>
</Layout>
