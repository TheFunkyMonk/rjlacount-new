---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const secondaryHeadline = 'my-4 font-bold text-3xl sm:text-4xl md:text-5xl leading-tight text-purple-600 dark:text-white';
---

<Layout title={`${post.data.title} - R.J. LaCount`} description={post.data.description} noindex>
	<section class="mt-8 md:mt-16 lg:mt-24 mb-16 md:mb-24 relative z-10">
		<div class="container mx-auto">
			<div class="flex flex-wrap h-full pt-8 md:py-8 xl:py-16">
				<div class="w-full px-4">
					<h1 class={secondaryHeadline}>{post.data.title}</h1>
					<div class="prose prose-lg dark:prose-invert max-w-none">
						<Content />
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
