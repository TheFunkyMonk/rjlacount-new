---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	class?: string;
}

const { src, alt, class: className = '' } = Astro.props;

// Generates the low-res blur-up placeholder from the same source image at
// build time, so only one (high-res) image ever needs to be provided.
const placeholder = await getImage({ src, width: 24, format: 'webp', quality: 20 });
---

<span class={`relative block overflow-hidden ${className}`}>
	<img
		src={placeholder.src}
		alt=""
		aria-hidden="true"
		class="absolute inset-0 h-full w-full scale-110 object-cover blur-lg"
	/>
	<Image src={src} alt={alt} loading="lazy" decoding="async" class="relative w-full" />
</span>
